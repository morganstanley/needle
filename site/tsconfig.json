{
    "compilerOptions": {
        "target": "es2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["es2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "types": ["vite/client"],
        "paths": { "@needle": ["../main/index.ts"] },
        "baseUrl": ".",
        "experimentalDecorators": true,
        "useDefineForClassFields": false
    },
    "include": ["src", "vite.config.ts"]
}
